{
  "manifest_version": 3,
  "name": "앵무새",
  "version": "0.9.0",
  "description": "Parrot vNext experiment: opt-in user-script runner plus existing relay. NOT RELEASED.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "userScripts"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "route-state.js",
        "chatgpt-adapter.js",
        "signal-scanner.js",
        "prompt-compose.js",
        "repeat-policy.js",
        "runner-policy.js",
        "runner-registry.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "앵무새",
    "default_popup": "popup.html"
  },
  "options_page": "popup.html",
  "minimum_chrome_version": "135"
}
