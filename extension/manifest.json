{
  "manifest_version": 3,
  "name": "앵무새",
  "version": "0.8.7",
  "description": "ChatGPT 멀티 워커를 제어하고 durable receipt·COMPLETE·WAKE·MESSAGE 라우팅을 관리하는 로컬 앵무새 확장프로그램",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["route-state.js", "chatgpt-adapter.js", "signal-scanner.js", "prompt-compose.js", "repeat-policy.js", "runner-policy.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "앵무새", "default_popup": "popup.html" }
}
